{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@supabase/supabase-js": "^2.117.2",
    "expo": "~57.0.25",
    "expo-apple-authentication": "~57.0.2",
    "expo-asset": "^57.0.18",
    "expo-auth-session": "^57.0.13",
    "expo-camera": "^57.0.5",
    "expo-constants": "^57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-document-picker": "^57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "^57.0.4",
    "expo-image-picker": "^57.0.20",
    "expo-linking": "^57.0.11",
    "expo-print": "~57.0.2",
    "expo-router": "^57.0.23",
    "expo-secure-store": "^57.0.4",
    "expo-splash-screen": "^57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "^57.0.4",
    "expo-web-browser": "^57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "^3.3.0",
    "react-native-safe-area-context": "^5.10.0",
    "react-native-screens": "^4.28.0",
    "react-native-svg": "^15.15.5",
    "react-native-url-polyfill": "^4.0.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^57.0.13",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "jest": "^30.5.2",
    "jest-expo": "^57.0.5",
    "react-test-renderer": "19.2.3",
    "test-renderer": "^1.3.0",
    "typescript": "~6.0.3",
    "unpdf": "^1.8.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest && npm run test:pdf",
    "test:watch": "jest --watch",
    "test:unit": "jest",
    "test:pdf": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js --config jest.pdf.config.js --silent"
  },
  "private": true,
  "overrides": {
    "react-native-worklets": "^0.13.0"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "clearMocks": true,
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/__tests__/testUtils\\.tsx$",
      "\\.pdf\\.test\\.ts$",
      "/__tests__/functions/(fixtures|handlerHarness)\\.ts$"
    ],
    "collectCoverageFrom": [
      "components/**/*.{ts,tsx}",
      "services/**/*.{ts,tsx}",
      "!**/node_modules/**"
    ],
    "modulePaths": [
      "<rootDir>/node_modules"
    ]
  }
}
