{
  "expo": {
    "name": "AneviaOne",
    "slug": "health-intelligence-app",
    "version": "1.0.0",
    "scheme": "healthintelligence",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.healthintelligence.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Your camera is used to capture photos of health reports and prescriptions so they can be added to your Health Memory.",
        "NSPhotoLibraryUsageDescription": "Access to your photos lets you upload existing health documents."
      }
    },
    "android": {
      "package": "ai.healthintelligence.app",
      "adaptiveIcon": {
        "backgroundColor": "#F7F5F0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": ["CAMERA", "READ_MEDIA_IMAGES"]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A1426",
          "image": "./assets/icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Your camera is used to capture photos of health reports and prescriptions."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Access to your photos lets you upload existing health documents."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
