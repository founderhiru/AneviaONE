{
  "cli": {
    "version": ">= 24.10.0 < 25.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_APP_MODE": "production"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_APP_MODE": "production"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_APP_MODE": "production",
        "EXPO_PUBLIC_VAULT_FILES": "on",
        "EXPO_PUBLIC_NAV_V2": "on"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6819075705"
      }
    }
  }
}
